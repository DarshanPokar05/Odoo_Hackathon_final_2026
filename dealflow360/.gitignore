backend/prisma/*.db
backend/prisma/*.db-journal

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
npm-install.log
prisma-migrate.log
prisma-seed.log

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ── PDF output (generated at runtime) ─────────────────────────────────────────
backend/invoices/*.pdf
