{
  "name": "dealflow-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready reusable authentication module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean",
    "db:generate": "pnpm --filter @auth-module/backend db:generate",
    "db:migrate": "pnpm --filter @auth-module/backend db:migrate",
    "db:push": "pnpm --filter @auth-module/backend db:push",
    "db:studio": "pnpm --filter @auth-module/backend db:studio"
  },
  "devDependencies": {
    "typescript": "5.4.5"
  }
}
