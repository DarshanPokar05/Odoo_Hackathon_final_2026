{
  "name": "dealflow-backend",
  "version": "1.0.0",
  "description": "Example application integrating @auth-module/backend",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "db:generate": "prisma generate --schema=../../packages/backend/prisma/schema.prisma",
    "db:push": "prisma db push --schema=../../packages/backend/prisma/schema.prisma"
  },
  "dependencies": {
    "@auth-module/backend": "workspace:*",
    "@auth-module/core": "workspace:*",
    "dotenv": "16.4.5",
    "express": "4.19.2"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "20.14.2",
    "rimraf": "5.0.7",
    "ts-node-dev": "2.0.0",
    "typescript": "5.4.5"
  }
}
