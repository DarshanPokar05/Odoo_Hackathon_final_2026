{
  "name": "@auth-module/backend",
  "version": "1.0.0",
  "description": "Express + Prisma backend for the auth module",
  "main": "./dist/index.public.js",
  "types": "./dist/index.public.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "ts-node src/db/seed.ts"
  },
  "dependencies": {
    "@auth-module/core": "workspace:*",
    "@prisma/client": "5.14.0",
    "@types/nodemailer": "6.4.15",
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.6",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "express-rate-limit": "7.3.1",
    "helmet": "7.1.0",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.10.0",
    "nodemailer": "6.9.14",
    "uuid": "10.0.0",
    "winston": "3.13.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.7",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.6",
    "@types/morgan": "1.9.9",
    "@types/node": "20.14.2",
    "@types/supertest": "6.0.2",
    "@types/uuid": "10.0.0",
    "@vitest/coverage-v8": "1.6.0",
    "prisma": "5.14.0",
    "rimraf": "5.0.7",
    "supertest": "7.0.0",
    "ts-node-dev": "2.0.0",
    "typescript": "5.4.5",
    "vitest": "1.6.0"
  }
}
