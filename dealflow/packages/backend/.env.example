# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/auth_module_db?schema=public"

# ── JWT Secrets (generate with: openssl rand -hex 64) ────────────────────────
AUTH_ACCESS_TOKEN_SECRET="REPLACE_WITH_64_BYTE_HEX_SECRET"
AUTH_REFRESH_TOKEN_SECRET="REPLACE_WITH_DIFFERENT_64_BYTE_HEX_SECRET"
AUTH_ACCESS_TOKEN_EXPIRES_IN="15m"
AUTH_REFRESH_TOKEN_EXPIRES_IN="7d"
AUTH_JWT_ISSUER="auth-module"
AUTH_JWT_AUDIENCE="auth-module-client"

# ── Cookie ────────────────────────────────────────────────────────────────────
AUTH_COOKIE_NAME="auth_refresh_token"

# ── OTP ───────────────────────────────────────────────────────────────────────
AUTH_OTP_LENGTH=6
AUTH_OTP_EXPIRATION_SECONDS=300
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_MAX_OTP_ATTEMPTS=5
AUTH_MAX_OTP_RESENDS=5

# ── Password ──────────────────────────────────────────────────────────────────
AUTH_PASSWORD_MIN_LENGTH=8

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=4000
AUTH_APP_NAME="MyApp"
AUTH_APP_BASE_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# ── Email Provider (configure the provider you use) ──────────────────────────
EMAIL_PROVIDER="console"        # console | smtp | sendgrid | ses
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="user@example.com"
SMTP_PASS="smtp_password"
SMTP_FROM="no-reply@example.com"

# SENDGRID_API_KEY="SG.xxx"
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="xxx"
# AWS_SECRET_ACCESS_KEY="xxx"
# SES_FROM_EMAIL="no-reply@example.com"

# ── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID="rzp_test_7mjUrQNHheuUWf"
RAZORPAY_KEY_SECRET="JN6gILnO1f4WNlX85351Z808"

# ── SMS Provider ──────────────────────────────────────────────────────────────
SMS_PROVIDER="console"          # console | twilio | sns
# TWILIO_ACCOUNT_SID="ACxxx"
# TWILIO_AUTH_TOKEN="xxx"
# TWILIO_FROM_NUMBER="+1234567890"
